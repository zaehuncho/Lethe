; VVM_PROG_UNSEAL_CACHE -- virtualizes SecurityManager::unprotectBytes()
;
; Unseals DPAPI-protected data using machine-bound entropy.
; Entropy = "orion-entitlement-v1|" + hex(SHA256(hostname|uniqueId|guid))
; Mirror of seal_cache.vasm, calling dpapi_unprotect instead of dpapi_protect.
;
; args[0] = &VmExternals       (function pointer table)
; args[1] = ciphertext_ptr     (const uint8_t*)
; args[2] = ciphertext_len     (uint32_t, as u64)
; args[3] = out_buf            (uint8_t*, caller-allocated)
; args[4] = out_max_len        (uint32_t, as u64)
;
; VmExternals offsets used:
;    0 = get_hostname(buf, bufsize)            -> chars written, 0=fail
;    8 = get_machine_guid(buf, bufsize)        -> chars written, 0=fail
;   16 = get_machine_unique_id(buf, bufsize)   -> bytes written, 0=fail
;   40 = sha256_buf(data, len, out32)          -> 0=ok, 1=fail
;   56 = dpapi_unprotect(in, in_len, entropy, ent_len, out, out_max)
;                                              -> bytes written, -1=fail
;
; Locals memory map:
;   [0..255]     material    256 bytes (hostname|uniqueId|guid)
;   [256..287]   sha_out     32 bytes (SHA256 of material)
;   [288..351]   hex_id      64 bytes (lowercase hex-encoded machineId)
;   [352..436]   entropy     85 bytes (21-byte prefix + 64 hex chars)
;   [440..447]   mat_len     u64 (running material byte count)
;   [448..455]   sha_ptr     u64 (read pointer for hex encoding)
;   [456..463]   hex_ptr     u64 (write pointer for hex encoding)
;
; Data section:
;   [0..15]      hex_lut     "0123456789abcdef"
;   [16..36]     ent_pfx     "orion-entitlement-v1|"
;
; Contract: DATA — >=0 bytes written on success, -1=error
; Return: halt with dpapi_unprotect result (bytes written, or -1)

.data
  hex_lut: db 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37
  db 0x38, 0x39, 0x61, 0x62, 0x63, 0x64, 0x65, 0x66
  ent_pfx: db 0x6F, 0x72, 0x69, 0x6F, 0x6E, 0x2D, 0x65, 0x6E
  db 0x74, 0x69, 0x74, 0x6C, 0x65, 0x6D, 0x65, 0x6E
  db 0x74, 0x2D, 0x76, 0x31, 0x7C

.code
  ; ---- main entry ----
  call build_entropy
  jnz fail_neg1

  ; ---- call dpapi_unprotect ----
  ; dpapi_unprotect(ciphertext, len, entropy, ent_len, out, out_max)
  push_arg 1                ; ciphertext_ptr
  push_arg 2                ; ciphertext_len
  local_addr 352            ; entropy (&locals[352])
  push_imm8 85              ; entropy_len = 21 + 64
  push_arg 3                ; out_buf
  push_arg 4                ; out_max_len
  push_imm8 6               ; argc
  push_arg 0                ; &VmExternals
  push_imm8 56              ; offset 56 = dpapi_unprotect
  add
  load64
  n_call_ptr                ; -> bytes written or -1
  halt

fail_neg1:
  push_imm8 1
  neg                       ; twos-complement -1
  halt

; ============================================================
; Subroutine: build_entropy
;
; Identical logic to seal_cache.vasm -- computes machineId and
; assembles the 85-byte DPAPI entropy in locals[352..436].
;
; Stack convention: pushes 0 on success, nonzero on failure.
; ============================================================
build_entropy:

  ; ---- Step 1: build material = hostname|uniqueId|guid ----

  ; mat_len = 0
  local_addr 440
  push_imm8 0
  store64

  ; -- get_hostname(&locals[0], 256) --
  local_addr 0
  push_imm16 256
  push_imm8 2
  push_arg 0
  load64                    ; offset 0 = get_hostname
  n_call_ptr
  ; mat_len = hostname_len
  local_addr 440
  swap
  store64

  ; append '|'
  local_addr 0
  local_addr 440
  load64
  add
  push_imm8 0x7C
  store8
  local_addr 440
  dup
  load64
  push_imm8 1
  add
  store64

  ; -- get_machine_unique_id(&locals[mat_len], 256 - mat_len) --
  local_addr 0
  local_addr 440
  load64
  add
  push_imm16 256
  local_addr 440
  load64
  sub
  push_imm8 2
  push_arg 0
  push_imm8 16              ; offset 16 = get_machine_unique_id
  add
  load64
  n_call_ptr
  ; mat_len += uid_len
  local_addr 440
  load64
  add
  local_addr 440
  swap
  store64

  ; append '|'
  local_addr 0
  local_addr 440
  load64
  add
  push_imm8 0x7C
  store8
  local_addr 440
  dup
  load64
  push_imm8 1
  add
  store64

  ; -- get_machine_guid(&locals[mat_len], 256 - mat_len) --
  local_addr 0
  local_addr 440
  load64
  add
  push_imm16 256
  local_addr 440
  load64
  sub
  push_imm8 2
  push_arg 0
  push_imm8 8               ; offset 8 = get_machine_guid
  add
  load64
  n_call_ptr
  ; mat_len += guid_len
  local_addr 440
  load64
  add
  local_addr 440
  swap
  store64

  ; ---- Step 2: SHA256(material, mat_len) -> sha_out ----
  local_addr 0
  local_addr 440
  load64
  local_addr 256
  push_imm8 3
  push_arg 0
  push_imm8 40              ; offset 40 = sha256_buf
  add
  load64
  n_call_ptr
  push_imm8 0
  cmp_ne
  jnz build_fail

  ; ---- Step 3: hex-encode SHA256 -> locals[288..351] ----

  local_addr 448
  local_addr 256
  store64                   ; sha_ptr = &sha_out

  local_addr 456
  local_addr 288
  store64                   ; hex_ptr = &hex_id

hex_loop:
  local_addr 448
  load64
  local_addr 288
  cmp_lt                    ; sha_ptr < &locals[288]?
  jz hex_done

  local_addr 448
  load64
  load8                     ; byte

  ; high nibble -> hex char via LUT
  dup
  push_imm8 4
  shr
  data_addr 0
  add
  load8                     ; hi_char

  local_addr 456
  load64
  swap
  store8                    ; *hex_ptr = hi_char

  ; low nibble -> hex char via LUT
  push_imm8 0x0F
  and
  data_addr 0
  add
  load8                     ; lo_char

  local_addr 456
  load64
  push_imm8 1
  add
  swap
  store8                    ; *(hex_ptr+1) = lo_char

  ; sha_ptr++
  local_addr 448
  dup
  load64
  push_imm8 1
  add
  store64

  ; hex_ptr += 2
  local_addr 456
  dup
  load64
  push_imm8 2
  add
  store64

  jmp hex_loop

hex_done:
  ; ---- Step 4: build entropy in locals[352..436] ----

  ; copy prefix from data[16]
  local_addr 352
  data_addr 16
  push_imm8 21
  n_copy_mem

  ; copy hex machineId from locals[288] to locals[373]
  local_addr 373
  local_addr 288
  push_imm8 64
  n_copy_mem

  push_imm8 0
  ret

build_fail:
  push_imm8 1
  ret
