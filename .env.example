# Lethe shard-gate environment variables. Export these from your shell or
# secret manager; this file is documentation and is not loaded automatically.
# NEVER commit real values (a local `.env` remains ignored).

# Preferred alternative to putting the bearer token in --shard-auth / argv.
LETHE_SHARD_AUTH=

# Optional leaf/issuing-CA certificate pin used by the uploader.
LETHE_SHARD_PIN_PEM=
